{
  "kind": "collectionType",
  "collectionName": "customers",
  "info": {
    "singularName": "customer",
    "pluralName": "customers",
    "displayName": "Customer",
    "description": "Customer profile information"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "customerCode": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "fullName": {
      "type": "string",
      "required": true
    },
    "customerTier": {
      "type": "enumeration",
      "required": true,
      "default": "silver",
      "enum": [
        "silver",
        "gold",
        "platinum",
        "diamond"
      ]
    },
    "gender": {
      "type": "enumeration",
      "enum": [
        "male",
        "female",
        "other"
      ]
    },
    "dateOfBirth": {
      "type": "date"
    },
    "maritalStatus": {
      "type": "enumeration",
      "enum": [
        "single",
        "married",
        "divorced",
        "widowed"
      ]
    },
    "mobilePhone": {
      "type": "string"
    },
    "homePhone": {
      "type": "string"
    },
    "officePhone": {
      "type": "string"
    },
    "email": {
      "type": "email"
    },
    "address1": {
      "type": "string",
      "required": true
    },
    "address2": {
      "type": "string"
    },
    "hasUsedDConnect": {
      "type": "boolean",
      "required": true,
      "default": false
    },
    "lastDConnectLoginAt": {
      "type": "datetime"
    },
    "hasRegisteredEkyc": {
      "type": "boolean",
      "required": true,
      "default": false
    },
    "lastEkycRegisteredAt": {
      "type": "datetime"
    },
    "rewardPoints": {
      "type": "integer",
      "required": true,
      "default": 0,
      "min": 0
    },
    "purchasedContractsCount": {
      "type": "integer",
      "required": true,
      "default": 0,
      "min": 0
    },
    "insuredContractsCount": {
      "type": "integer",
      "required": true,
      "default": 0,
      "min": 0
    },
    "insurance_contracts": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::insurance-contract.insurance-contract",
      "mappedBy": "customer"
    }
  }
}
